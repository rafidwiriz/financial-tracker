# Copy to .env and adjust. Never commit real values (docs/conventions.md).

# Local PostgreSQL (docker-compose db service)
POSTGRES_USER=ft
POSTGRES_PASSWORD=ft
POSTGRES_DB=ft

# App connection string (host `db` inside compose; use localhost when running
# the binary directly on the host)
DATABASE_URL=postgres://ft:ft@db:5432/ft?sslmode=disable

# HTTP server
HTTP_ADDR=:8080

# Host port mapped to the container's 8080 (changes require a decision entry)
# HTTP_PORT=8080

# PaaS platforms inject PORT; when set it overrides HTTP_ADDR (conventions.md)
# PORT=8000

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Seeded single-user identity (D-018). Override only if you know what you're doing.
# DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001